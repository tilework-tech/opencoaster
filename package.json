{
  "name": "opencoaster",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "predev": "pnpm art:prepare && pnpm art:pack && pnpm scenario-previews:generate",
    "prebuild": "pnpm art:prepare && pnpm art:pack && pnpm scenario-previews:generate",
    "scenario-previews:generate": "tsx tools/scenario-previews/generate.ts",
    "sprites:render": "tsx tools/sprites/cli.ts",
    "sprites:track-sheet": "tsx tools/sprites/track-sheet.ts",
    "art:prepare": "tsx tools/art/prepare.ts && pnpm art:characters",
    "art:pack": "tsx tools/art/pack-cli.ts",
    "art:coverage": "tsx tools/sprites/coverage.ts",
    "art:review": "tsx tools/art/review.ts",
    "art:characters": "tsx tools/art/process-sprites.ts --input tools/art/source/staff-costumes.png --output public/sprites/people/staff-costumes.png --name staff-costumes --columns 4 --rows 4 --cell-size 32 --palette-variants 1",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "art:process": "tsx tools/art/process-sprites.ts",
    "bench": "tsx bench/bench.ts",
    "bench:audio": "tsx bench/audio.ts",
    "balance": "tsx bench/balance.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "playwright test --config=playwright.config.ts",
    "smoke:subpath": "pnpm build && playwright test --config=playwright.subpath.config.ts",
    "e2e": "playwright test --config=playwright.e2e.config.ts --grep-invert \"@art-review|@art-context-review\"",
    "e2e:art-review": "playwright test --config=playwright.art-review.config.ts --grep \"@art-review|@art-context-review\"",
    "e2e:quick": "playwright test --config=playwright.e2e.config.ts --grep-invert \"@art-review|pixel-8|Pixel 8|Pixel-class|dragging previews|run the player cannot|surface and queue|remove toggle|hint the first|piece mode|piece direction|refused tile|turning corner|lower and smooth|land outside|dragging up|flatten|phone speed|Options Game tab|step through the speeds\" e2e/area-tools e2e/camera-rotation e2e/context-menu e2e/desktop-toolbar e2e/footpath-tool e2e/game-speed-controls e2e/land-tool e2e/message-controls"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
