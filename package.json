{
  "name": "opencoaster",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "predev": "pnpm art:prepare && pnpm art:pack",
    "prebuild": "pnpm art:prepare && pnpm art:pack",
    "sprites:render": "tsx tools/sprites/cli.ts",
    "art:prepare": "tsx tools/art/prepare.ts && pnpm art:characters",
    "art:pack": "tsx tools/art/pack-cli.ts",
    "art:coverage": "tsx tools/sprites/coverage.ts",
    "art:characters": "tsx tools/art/process-sprites.ts --input tools/art/source/guest-walk.png --output public/sprites/people/guest-walk.png --name guest-walk --columns 4 --rows 4 --cell-size 32 --palette-variants 8 --mask-output .local/art-processing/guest-walk-mask.png && tsx tools/art/process-sprites.ts --input tools/art/source/staff-costumes.png --output public/sprites/people/staff-costumes.png --name staff-costumes --columns 4 --rows 4 --cell-size 32 --palette-variants 1",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "art:process": "tsx tools/art/process-sprites.ts",
    "bench": "tsx bench/bench.ts",
    "bench:audio": "tsx bench/audio.ts",
    "balance": "tsx bench/balance.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "playwright test --config=playwright.config.ts",
    "smoke:subpath": "pnpm build && playwright test --config=playwright.subpath.config.ts",
    "e2e": "playwright test --config=playwright.e2e.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
